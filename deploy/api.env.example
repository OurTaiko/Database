# /etc/ourtaiko-database/api.env on ourtaiko-prod — root-only. Never commit real values.
# PostgreSQL is the shared ourtaiko-postgres instance on the ourtaiko-shared
# network (moved from sakura 2026-10-23); the database and its owner role are
# both ourtaiko_database.
DATABASE_URL=postgres://ourtaiko_database:<password>@postgres:5432/ourtaiko_database?sslmode=disable
APP_ORIGIN=https://database.ourtaiko.org
COOKIE_SECURE=true
# Gateway of the ourtaiko-shared network: OpenResty forwards X-Real-IP.
TRUSTED_PROXY_CIDRS=172.20.0.1/32

SSO_ISSUER=https://sso.ourtaiko.org
SSO_SERVICE_ID=
SSO_SERVICE_KEY=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URL=https://database.ourtaiko.org/api/v1/auth/sso/callback
# openssl rand -hex 32; keep stable.
SESSION_ENCRYPTION_KEY=
SSO_AVATAR_BASE_URL=https://distrib.ourtaiko.org/sso/avatars

PROFILE_URL=https://profile.ourtaiko.org
PROFILE_SERVICE_ID=
PROFILE_SERVICE_KEY=

S3_BUCKET=ourtaiko-public
AWS_REGION=ap-northeast-1
S3_PREFIX=database
S3_PUBLIC_BASE_URL=https://distrib.ourtaiko.org/database
# An IAM identity limited to ourtaiko-public/database/*.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

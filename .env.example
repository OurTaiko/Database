DATABASE_URL=postgres://localhost/ourtaiko_database?host=/tmp&sslmode=disable
LISTEN_ADDR=127.0.0.1:8081
APP_ORIGIN=http://127.0.0.1:5174
# Local object directory; files are stored flat as {sha256}.{extension}.
STORAGE_DIR=.data/files
COOKIE_SECURE=false
# Set only behind a proxy that overwrites X-Real-IP. Empty ignores forwarded IPs.
TRUSTED_PROXY_CIDRS=

# OurTaiko account center. Leave SSO_ISSUER empty to run a public, read-only
# catalogue without sign-in.
SSO_ISSUER=
# Optional Docker TCP route, e.g. sso:8090. Does not change issuer/Host/TLS checks.
SSO_CONNECT_ADDRESS=
SSO_SERVICE_ID=
SSO_SERVICE_KEY=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URL=http://127.0.0.1:5174/api/v1/auth/sso/callback
# Generate once with openssl rand -hex 32. Keep stable across restarts/replicas.
SESSION_ENCRYPTION_KEY=
# Allowed SSO avatar prefix, e.g. https://cdn.example.com/sso/avatars
SSO_AVATAR_BASE_URL=

# Local development without an account center: "sign in" becomes this user
# (32 lowercase hex characters), who is an administrator. Refused together
# with SSO_ISSUER or a non-loopback LISTEN_ADDR.
DEV_USER_ID=
